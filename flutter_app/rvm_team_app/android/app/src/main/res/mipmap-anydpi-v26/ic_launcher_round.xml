<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+): the maroon plate is the background layer and the
     transparent RVM logo is the foreground, sized inside the 66dp safe zone.
     Before this file existed the manifest pointed at the FOREGROUND bitmap, so
     launchers wrapped it as a legacy icon and added a white plate plus an
     inset — the "extra padding" around the logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the logo alone, tinted by the system. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
