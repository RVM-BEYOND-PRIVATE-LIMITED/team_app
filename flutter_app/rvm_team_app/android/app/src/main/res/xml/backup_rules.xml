<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_secure_storage keeps its ciphertext in these SharedPreferences
     files while the key that decrypts them lives in the non-exportable Android
     Keystore. Backing up the ciphertext restores data that a reinstall or a
     new device can never decrypt (BadPaddingException at splash). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
