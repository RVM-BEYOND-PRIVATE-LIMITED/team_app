<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ reads these rules instead of full-backup-content. Exclude the
     flutter_secure_storage files from both cloud backup and device transfer so
     ciphertext is never restored without its Keystore key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
