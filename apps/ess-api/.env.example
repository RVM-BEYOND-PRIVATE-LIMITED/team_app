# Team RVM ESS settings. Copy to apps/ess-api/.env for local work and fill in your own values.
#
# Placeholders only. The real values live in the team_app repository secrets and variables;
# the deploy (.github/workflows/deploy-ess.yml) writes them into .env on the server. Never
# commit a filled-in .env: .gitignore blocks it.
#
# One line per value, no quotes. src/config.js checks every value at start-up and refuses to
# start, naming what is wrong (never printing a value), if one is missing or malformed.

# Port to listen on. pm2 sets 3001 (ecosystem.config.cjs); nginx forwards /api/ess/ to it.
PORT=3001

# Address to listen on. Empty means 127.0.0.1: nginx on the same server is the only caller, so
# point its proxy_pass at http://127.0.0.1:3001. 0.0.0.0 opens the port to the network; never
# do that on the server.
HOST=

# REQUIRED. The Scheduler's own JWT_SECRET, exactly the same value, at least 32 characters.
# The ESS verifies the tokens the Scheduler issues with it, so a different value refuses
# every sign-in.
JWT_SECRET=

# REQUIRED. The Scheduler's Supabase project and its service-role key (every HR table is
# row-level-security deny-all). Use a local stack for development, never production.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# The off switch. "false" turns every endpoint except /api/ess/health into 503
# MODULE_DISABLED after a restart. Anything else, or nothing, leaves the ESS on.
ESS_ENABLED=

# What /api/ess/health reports as the server's version: APP_VERSION if set, else GIT_SHA
# (the deploy writes the commit), else the package version.
APP_VERSION=
GIT_SHA=

# The app versions /api/ess/health reports, as semver (1.4.0 or 1.4.0+12). Below the
# minimum the app must update; the latest is offered. Leave empty until the app ships.
MIN_APP_VERSION=
LATEST_APP_VERSION=

# Push. Until all three are set, push messages are written to the log instead of being sent
# (ADR-0016). The private key is the service account's PEM, base64-encoded on one line:
#   base64 -w0 service-account-key.pem
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_B64=
